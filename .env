# Public address of the deployed site, with a trailing slash.
# Used to build the absolute og:image / twitter:image URLs that link
# previews need. Currently the GitHub Pages address for this repo.
# Change this one line when the site moves to a custom domain, e.g.
#   VITE_SITE_URL=https://bufordroofing.com/ice-shaker/
# Leaving it empty is also safe: the tags fall back to page-relative paths.
VITE_SITE_URL=https://pamux.github.io/buford-roofing-ice-shaker/
